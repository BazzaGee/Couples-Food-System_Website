---
import BaseHead from '../components/layout/BaseHead.astro';
import '../styles/global.css';
---

<!DOCTYPE html>
<html lang="en">
<head>
  <BaseHead
    title="Cost, Pricing & Profitability — CUPLA"
    description="Complete unit economics: DeepSeek V4 Flash costs, pricing strategy, conversion sensitivity, churn/LTV, and path to NZ$150K/year net profit."
    canonicalURL="/economics"
  />
  <meta name="robots" content="noindex, nofollow" />
</head>
<body class="bg-cream text-text-primary antialiased leading-relaxed overflow-x-hidden">

  <!-- MINIMAL NAV (SpokeNav pattern) -->
  <nav class="fixed top-0 w-full z-50 proposal-nav-glow-subtle border-b border-border/50 backdrop-blur-md bg-cream/90">
    <div class="max-w-6xl mx-auto px-6 h-14 flex items-center justify-between">
      <a href="/" class="text-sage hover:text-sage-dark transition-colors text-sm font-medium flex items-center gap-2">
        <span class="text-base">&larr;</span>
        <span class="hidden sm:inline">Back to Home</span>
        <span class="sm:hidden">Home</span>
      </a>
      <div class="flex items-center gap-2">
        <span class="text-text-primary font-semibold text-sm tracking-wide">CUPLA</span>
        <span class="text-text-secondary text-sm">&middot; Internal Analysis</span>
      </div>
    </div>
  </nav>

  <!-- HERO -->
  <section class="pt-20 md:pt-28 pb-16 px-6 relative">
    <div class="absolute inset-0 -z-10 opacity-20" style="background-image: radial-gradient(circle, #7A9E7E 1px, transparent 1px); background-size: 24px 24px;"></div>
    <div class="max-w-4xl mx-auto">
      <div class="flex items-center gap-3 mb-4">
        <span class="text-xs text-text-secondary font-medium uppercase tracking-wider">June 14, 2026</span>
        <span class="bg-terracotta/15 text-terracotta-dark text-xs px-2 py-1 rounded-full font-semibold">Internal Use Only</span>
      </div>
      <h1 class="proposal-hero-title mb-6">
        Cost, Pricing &<br/>Profitability Analysis
      </h1>
      <p class="text-lg text-text-secondary leading-relaxed max-w-2xl">
        Complete unit economics for Cupla's couples meal planning app. Powered by DeepSeek V4 Flash at <strong class="text-sage-dark">94.7x cheaper</strong> than OpenAI's GPT-5.5. One subscription per couple. Revenue in USD, operating in NZD.
      </p>
    </div>

    <!-- HEADLINE STATS -->
    <div class="max-w-6xl mx-auto mt-14 grid grid-cols-2 md:grid-cols-4 gap-4">
      <div class="stat-card hover:shadow-md transition-shadow">
        <div class="stat-number">NZ$0.00086</div>
        <div class="stat-label">Per AI Request</div>
      </div>
      <div class="stat-card hover:shadow-md transition-shadow">
        <div class="stat-number">94.7x</div>
        <div class="stat-label">Cheaper Than GPT-5.5</div>
      </div>
      <div class="stat-card hover:shadow-md transition-shadow">
        <div class="stat-number">NZ$66.18</div>
        <div class="stat-label">Profit / Paid Couple / Year</div>
      </div>
      <div class="stat-card hover:shadow-md transition-shadow">
        <div class="stat-number">~39,100</div>
        <div class="stat-label">Couples for NZ$150K (10% conv)</div>
      </div>
    </div>
  </section>

  <!-- 01. PRICING TIERS -->
  <section class="spoke-section-alt">
    <div class="max-w-6xl mx-auto px-6">
      <div class="mb-10">
        <span class="text-xs font-bold text-sage tracking-wider uppercase">01 &middot; Pricing</span>
        <h2 class="proposal-section-title mt-1">Pricing Tiers</h2>
        <p class="proposal-section-subtitle">One subscription per couple. Both partners share the same request pool.</p>
      </div>

      <div class="grid md:grid-cols-3 gap-6 mb-10">
        <!-- Free -->
        <div class="pitch-card flex flex-col">
          <h3 class="text-xl font-bold mb-1">Free</h3>
          <div class="text-4xl font-bold text-text-primary mb-4">$0</div>
          <ul class="space-y-2.5 text-sm text-text-secondary flex-grow mb-6">
            <li class="flex items-start gap-2"><svg class="w-4 h-4 text-sage mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg> 10 requests/day (shared)</li>
            <li class="flex items-start gap-2"><svg class="w-4 h-4 text-sage mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg> 300 requests/month</li>
            <li class="flex items-start gap-2"><svg class="w-4 h-4 text-sage mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg> DeepSeek V4 Flash &mdash; frontier AI</li>
            <li class="flex items-start gap-2"><svg class="w-4 h-4 text-sage mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg> 1M token context window</li>
            <li class="flex items-start gap-2"><svg class="w-4 h-4 text-sage mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg> No ads, full priority</li>
            <li class="flex items-start gap-2"><svg class="w-4 h-4 text-sage mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg> Real-time sync between partners</li>
          </ul>
          <div class="pt-4 border-t border-border">
            <div class="text-xs text-text-secondary">AI cost to Cupla</div>
            <div class="text-lg font-bold text-text-primary">NZ$0.26<span class="text-sm font-normal text-text-secondary">/month</span></div>
          </div>
        </div>

        <!-- Monthly -->
        <div class="pitch-card border-2 border-sage relative flex flex-col">
          <div class="absolute -top-3 left-1/2 -translate-x-1/2 bg-sage text-white text-xs font-semibold px-3 py-1 rounded-full">Most Popular</div>
          <h3 class="text-xl font-bold mb-1">Monthly</h3>
          <div class="text-4xl font-bold text-sage-dark mb-4">US$4.99<span class="text-base font-normal text-text-secondary">/mo</span></div>
          <ul class="space-y-2.5 text-sm text-text-secondary flex-grow mb-6">
            <li class="flex items-start gap-2"><svg class="w-4 h-4 text-sage mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg> 70 requests/day (shared)</li>
            <li class="flex items-start gap-2"><svg class="w-4 h-4 text-sage mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg> 2,100 requests/month (7x free)</li>
            <li class="flex items-start gap-2"><svg class="w-4 h-4 text-sage mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg> Effectively unlimited for any couple</li>
            <li class="flex items-start gap-2"><svg class="w-4 h-4 text-sage mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg> All free features included</li>
            <li class="flex items-start gap-2"><svg class="w-4 h-4 text-sage mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg> Cancel anytime</li>
          </ul>
          <div class="pt-4 border-t border-border">
            <div class="text-xs text-text-secondary">Profit to Cupla (Stripe)</div>
            <div class="text-lg font-bold text-sage-dark">NZ$6.24<span class="text-sm font-normal text-text-secondary">/month</span></div>
          </div>
        </div>

        <!-- Yearly -->
        <div class="pitch-card-terracotta flex flex-col">
          <h3 class="text-xl font-bold mb-1">Yearly</h3>
          <div class="text-4xl font-bold text-terracotta-dark mb-4">US$44.99<span class="text-base font-normal text-text-secondary">/yr</span></div>
          <ul class="space-y-2.5 text-sm text-text-secondary flex-grow mb-6">
            <li class="flex items-start gap-2"><svg class="w-4 h-4 text-terracotta-dark mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg> Same 70 requests/day</li>
            <li class="flex items-start gap-2"><svg class="w-4 h-4 text-terracotta-dark mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg> <strong class="text-text-primary">Save 25%</strong> &mdash; 2.5 months free</li>
            <li class="flex items-start gap-2"><svg class="w-4 h-4 text-terracotta-dark mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg> Equivalent to US$3.75/month</li>
            <li class="flex items-start gap-2"><svg class="w-4 h-4 text-terracotta-dark mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg> Locked in for 12 months</li>
            <li class="flex items-start gap-2"><svg class="w-4 h-4 text-terracotta-dark mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg> Lower churn risk</li>
          </ul>
          <div class="pt-4 border-t border-terracotta/20">
            <div class="text-xs text-text-secondary">Profit to Cupla (Stripe)</div>
            <div class="text-lg font-bold text-terracotta-dark">NZ$4.43<span class="text-sm font-normal text-text-secondary">/month equiv</span></div>
          </div>
        </div>
      </div>

      <!-- What counts as 1 request -->
      <div class="max-w-2xl mx-auto bg-white rounded-2xl border border-border shadow-sm overflow-hidden">
        <div class="px-6 py-4 border-b border-border">
          <h3 class="text-base font-bold text-text-primary">What Counts as 1 Request</h3>
        </div>
        <div class="overflow-x-auto">
          <table class="comparison-table w-full">
            <tbody>
              <tr><td class="font-semibold">1 AI chat message</td><td class="font-bold text-sage-dark">1</td></tr>
              <tr><td class="font-semibold">1 meal generation</td><td class="font-bold text-sage-dark">1</td></tr>
              <tr><td class="font-semibold">1 pantry AI parse (batch)</td><td class="font-bold text-sage-dark">1</td></tr>
              <tr><td class="font-semibold">1 week meal plan (7 days)</td><td class="font-bold text-sage-dark">7</td></tr>
              <tr><td class="text-text-secondary">Image generation</td><td class="text-text-secondary">Separate quota (premium)</td></tr>
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </section>

  <!-- 02. DEEPSEEK PRICING -->
  <section class="spoke-section">
    <div class="max-w-4xl mx-auto px-6">
      <div class="mb-8">
        <span class="text-xs font-bold text-sage tracking-wider uppercase">02 &middot; AI Costs</span>
        <h2 class="proposal-section-title mt-1">DeepSeek API Pricing</h2>
        <p class="proposal-section-subtitle">Verified against <a href="https://api-docs.deepseek.com/quick_start/pricing" class="text-sage underline">api-docs.deepseek.com</a> on June 14, 2026. NZD at 1 USD = NZ$1.7148.</p>
      </div>

      <div class="bg-white rounded-2xl border border-border shadow-sm overflow-hidden mb-8">
        <div class="px-6 py-4 border-b border-border">
          <h3 class="text-base font-bold text-text-primary">Per 1M Tokens</h3>
        </div>
        <div class="overflow-x-auto">
          <table class="comparison-table w-full">
            <thead>
              <tr>
                <th class="rounded-tl-none">Model</th>
                <th>Input (cache miss)</th>
                <th>Cache Hit</th>
                <th>Output</th>
                <th class="rounded-tr-none">Role in Cupla</th>
              </tr>
            </thead>
            <tbody>
              <tr>
                <td class="font-semibold">V4 Flash</td>
                <td>US$0.14 <span class="text-text-secondary text-xs">(NZ$0.24)</span></td>
                <td>US$0.0028</td>
                <td>US$0.28 <span class="text-text-secondary text-xs">(NZ$0.48)</span></td>
                <td><span class="bg-sage/15 text-sage-dark text-xs px-2 py-1 rounded-full font-medium">Primary</span></td>
              </tr>
              <tr>
                <td class="font-semibold">V4 Pro</td>
                <td>US$0.435 <span class="text-text-secondary text-xs">(NZ$0.75)</span></td>
                <td>US$0.003625</td>
                <td>US$0.87 <span class="text-text-secondary text-xs">(NZ$1.49)</span></td>
                <td><span class="bg-terracotta/15 text-terracotta-dark text-xs px-2 py-1 rounded-full font-medium">Fallback only</span></td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>

      <!-- Per-operation costs -->
      <div class="bg-white rounded-2xl border border-border shadow-sm overflow-hidden mb-8">
        <div class="px-6 py-4 border-b border-border">
          <h3 class="text-base font-bold text-text-primary">Per-Operation Cost (V4 Flash, NZD)</h3>
        </div>
        <div class="overflow-x-auto">
          <table class="comparison-table w-full">
            <thead>
              <tr>
                <th class="rounded-tl-none">Operation</th>
                <th>Input Tokens</th>
                <th>Output Tokens</th>
                <th class="rounded-tr-none">Total Cost</th>
              </tr>
            </thead>
            <tbody>
              <tr><td class="font-semibold">Meal generation</td><td>800</td><td>1,200</td><td class="font-bold text-sage-dark">NZ$0.00077</td></tr>
              <tr><td class="font-semibold">AI chat message</td><td>1,500</td><td>1,500</td><td class="font-bold text-sage-dark">NZ$0.00108</td></tr>
              <tr><td class="font-semibold">Week plan (7 meals)</td><td>5,600</td><td>8,400</td><td class="font-bold text-sage-dark">NZ$0.00537</td></tr>
              <tr><td class="font-semibold">Pantry AI parsing</td><td>300</td><td>500</td><td class="font-bold text-sage-dark">NZ$0.00031</td></tr>
              <tr class="bg-sage/5"><td class="font-bold" colspan="3">Blended per-request (60% chat / 40% meal gen, conservative)</td><td class="font-bold text-sage-dark text-base">NZ$0.00086</td></tr>
            </tbody>
          </table>
        </div>
      </div>

      <!-- Real-world validation -->
      <div class="pitch-card-sage">
        <h3 class="text-lg font-bold mb-3">Real-World Validation</h3>
        <p class="text-sm text-text-secondary mb-4">User's actual measured usage (1 day, June 2026):</p>
        <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-4">
          <div><div class="text-2xl font-bold text-sage-dark">37</div><div class="text-xs text-text-secondary">Requests</div></div>
          <div><div class="text-2xl font-bold text-sage-dark">69K</div><div class="text-xs text-text-secondary">Tokens</div></div>
          <div><div class="text-2xl font-bold text-sage-dark">~1,865</div><div class="text-xs text-text-secondary">Tokens/Request</div></div>
          <div><div class="text-2xl font-bold text-sage-dark">NZ$0.03</div><div class="text-xs text-text-secondary">Cost/Day</div></div>
        </div>
        <p class="text-sm text-text-secondary">Calculated cost for actual mix (70% Flash, 30% Pro): NZ$0.0333/day. Matches observed ~NZ$0.034/day. <strong class="text-text-primary">Pricing verified.</strong></p>
      </div>
    </div>
  </section>

  <!-- 03. DEEPSEEK vs OPENAI -->
  <section class="spoke-section-alt">
    <div class="max-w-4xl mx-auto px-6">
      <div class="mb-8">
        <span class="text-xs font-bold text-sage tracking-wider uppercase">03 &middot; Comparison</span>
        <h2 class="proposal-section-title mt-1">DeepSeek vs OpenAI</h2>
        <p class="proposal-section-subtitle">Per-request cost comparison using blended 1,220 input + 1,380 output tokens.</p>
      </div>

      <div class="bg-white rounded-2xl border border-border shadow-sm overflow-hidden mb-8">
        <div class="overflow-x-auto">
          <table class="comparison-table w-full">
            <thead>
              <tr>
                <th class="rounded-tl-none">Model</th>
                <th>Per Request (USD)</th>
                <th>Per Request (NZD)</th>
                <th class="rounded-tr-none">Ratio vs V4 Flash</th>
              </tr>
            </thead>
            <tbody>
              <tr class="bg-sage/10"><td class="font-bold">DeepSeek V4 Flash</td><td>US$0.00050</td><td>NZ$0.00086</td><td class="font-bold">1x (baseline)</td></tr>
              <tr><td>DeepSeek V4 Pro</td><td>US$0.00150</td><td>NZ$0.00257</td><td>3.0x</td></tr>
              <tr><td>GPT-5.4-nano</td><td>US$0.00197</td><td>NZ$0.00338</td><td>3.9x</td></tr>
              <tr><td>GPT-5.4-mini</td><td>US$0.00713</td><td>NZ$0.01222</td><td>14.2x</td></tr>
              <tr><td>GPT-5.4</td><td>US$0.02375</td><td>NZ$0.04073</td><td>47.3x</td></tr>
              <tr class="bg-error/5"><td class="font-bold">GPT-5.5</td><td>US$0.04750</td><td>NZ$0.08145</td><td class="font-bold text-error">94.7x</td></tr>
              <tr class="bg-error/5"><td>GPT-5.5 Pro</td><td>US$0.25200</td><td>NZ$0.43213</td><td class="font-bold text-error">502.5x</td></tr>
            </tbody>
          </table>
        </div>
      </div>

      <div class="grid md:grid-cols-2 gap-6">
        <div class="bg-white rounded-2xl border border-border shadow-sm overflow-hidden">
          <div class="px-6 py-4 border-b border-border bg-sage/5">
            <h3 class="text-base font-bold text-text-primary">Free Tier Monthly Cost</h3>
            <p class="text-xs text-text-secondary mt-1">300 requests/month per couple</p>
          </div>
          <div class="overflow-x-auto">
            <table class="comparison-table w-full">
              <tbody>
                <tr class="bg-sage/10"><td class="font-bold">V4 Flash</td><td class="font-bold text-sage-dark">NZ$0.26</td></tr>
                <tr><td>GPT-5.4-nano</td><td>NZ$1.01</td></tr>
                <tr><td>GPT-5.4-mini</td><td>NZ$3.67</td></tr>
                <tr><td>GPT-5.5</td><td class="text-error font-medium">NZ$24.44</td></tr>
              </tbody>
            </table>
          </div>
        </div>
        <div class="bg-white rounded-2xl border border-border shadow-sm overflow-hidden">
          <div class="px-6 py-4 border-b border-border bg-sage/5">
            <h3 class="text-base font-bold text-text-primary">Paid Tier Monthly Cost</h3>
            <p class="text-xs text-text-secondary mt-1">2,100 requests/month per couple</p>
          </div>
          <div class="overflow-x-auto">
            <table class="comparison-table w-full">
              <tbody>
                <tr class="bg-sage/10"><td class="font-bold">V4 Flash</td><td class="font-bold text-sage-dark">NZ$1.80</td></tr>
                <tr><td>GPT-5.4-nano</td><td>NZ$7.09</td></tr>
                <tr><td>GPT-5.4-mini</td><td>NZ$25.66</td></tr>
                <tr><td>GPT-5.5</td><td class="text-error font-medium">NZ$171.05</td></tr>
              </tbody>
            </table>
          </div>
        </div>
      </div>

      <p class="text-sm text-text-secondary mt-6 text-center max-w-2xl mx-auto">
        Even OpenAI's cheapest model is <strong class="text-text-primary">3.9x more expensive</strong> than V4 Flash. GPT-5.5 (what ChatGPT free uses) is <strong class="text-text-primary">94.7x more expensive</strong>. DeepSeek's pricing makes it economically viable to give away substantial AI for free.
      </p>
    </div>
  </section>

  <!-- 04. PER-COUPLE ECONOMICS -->
  <section class="spoke-section">
    <div class="max-w-4xl mx-auto px-6">
      <div class="mb-8">
        <span class="text-xs font-bold text-sage tracking-wider uppercase">04 &middot; Unit Economics</span>
        <h2 class="proposal-section-title mt-1">Per-Couple Economics</h2>
        <p class="proposal-section-subtitle">Stripe channel, 60% monthly / 40% yearly uptake blend.</p>
      </div>

      <div class="grid md:grid-cols-3 gap-4 mb-8">
        <div class="stat-card hover:shadow-md transition-shadow">
          <div class="text-sm text-text-secondary mb-1">Monthly Subscriber</div>
          <div class="stat-number text-2xl">NZ$6.24</div>
          <div class="stat-label">Profit / month</div>
          <div class="text-sm font-medium text-text-primary mt-2">NZ$74.83 / year</div>
        </div>
        <div class="stat-card hover:shadow-md transition-shadow">
          <div class="text-sm text-text-secondary mb-1">Yearly Subscriber</div>
          <div class="stat-number text-2xl">NZ$4.43</div>
          <div class="stat-label">Profit / month equiv</div>
          <div class="text-sm font-medium text-text-primary mt-2">NZ$53.20 / year</div>
        </div>
        <div class="stat-card bg-sage/10 hover:shadow-md transition-shadow">
          <div class="text-sm text-text-secondary mb-1">Blended (60/40)</div>
          <div class="stat-number text-2xl">NZ$66.18</div>
          <div class="stat-label">Profit / couple / year</div>
          <div class="text-sm font-medium text-text-primary mt-2">NZ$5.52 / month</div>
        </div>
      </div>

      <div class="grid md:grid-cols-2 gap-6">
        <div class="pitch-card-terracotta">
          <h3 class="text-lg font-bold mb-2">Free Couple</h3>
          <div class="text-3xl font-bold text-terracotta-dark mb-2">-NZ$3.09<span class="text-base font-normal text-text-secondary">/year</span></div>
