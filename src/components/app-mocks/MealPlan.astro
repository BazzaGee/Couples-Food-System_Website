---
interface Props {
  version?: 'v1' | 'v2';
}

const { version = 'v1' } = Astro.props;
const isV2 = version === 'v2';
const primaryColor = isV2 ? 'text-v2-primary' : 'text-sage';
const primaryBg = isV2 ? 'bg-v2-primary' : 'bg-sage';
const surfaceBg = isV2 ? 'bg-v2-surface-container-lowest' : 'bg-white';
const surfaceBorder = isV2 ? 'border-v2-outline-variant' : 'border-border';
const textColor = isV2 ? 'text-v2-on-surface' : 'text-text-primary';
const textSecondary = isV2 ? 'text-v2-on-surface-variant' : 'text-text-secondary';
---

<div class={`${surfaceBg} rounded-2xl border ${surfaceBorder} overflow-hidden shadow-sm`}>
  <!-- App Header -->
  <div class={`px-4 py-3 border-b ${surfaceBorder} flex items-center justify-between`}>
    <div class="flex items-center gap-2">
      <div class={`w-6 h-6 rounded-lg ${primaryBg}`}></div>
      <span class={`text-sm font-semibold ${textColor}`}>Couples Food System</span>
    </div>
    <span class={`text-xs ${textSecondary}`}>Weekly Plan</span>
  </div>

  <!-- Week Navigation -->
  <div class={`px-4 py-2 border-b ${surfaceBorder} flex items-center justify-between`}>
    <button class={`text-xs ${textSecondary}`}>← Prev</button>
    <span class={`text-sm font-semibold ${textColor}`}>This Week</span>
    <button class={`text-xs ${textSecondary}`}>Next →</button>
  </div>

  <!-- Partner Goals Bar -->
  <div class={`px-4 py-2 border-b ${surfaceBorder} flex items-center gap-3`}>
    <div class="flex items-center gap-1.5">
      <div class={`w-3 h-3 rounded-full ${primaryBg}`}></div>
      <span class={`text-xs ${primaryColor}`}>Alex · 1,700 cal</span>
    </div>
    <div class="flex items-center gap-1.5">
      <div class={`w-3 h-3 rounded-full ${isV2 ? 'bg-v2-secondary' : 'bg-terracotta'}`}></div>
      <span class={`text-xs ${isV2 ? 'text-v2-secondary' : 'text-terracotta-dark'}`}>Jordan · 3,200 cal</span>
    </div>
  </div>

  <!-- Weekly Calendar -->
  <div class="p-4">
    <div class="space-y-2">
      <!-- Monday -->
      <div class={`rounded-xl border ${surfaceBorder} p-3`}>
        <div class="flex items-center justify-between mb-1">
          <span class={`text-xs font-semibold ${textColor}`}>Monday</span>
          <span class={`text-xs ${primaryColor} bg-opacity-10 px-2 py-0.5 rounded-full`}>2 missing items</span>
        </div>
        <p class={`text-sm ${textColor}`}>Chicken Stir-Fry with Rice</p>
        <p class={`text-xs ${textSecondary}`}>25 min · Both goals met</p>
      </div>
      <!-- Tuesday -->
      <div class={`rounded-xl border ${surfaceBorder} p-3`}>
        <div class="flex items-center justify-between mb-1">
          <span class={`text-xs font-semibold ${textColor}`}>Tuesday</span>
          <span class={`text-xs ${isV2 ? 'text-v2-secondary' : 'text-terracotta-dark'} bg-opacity-10 px-2 py-0.5 rounded-full`}>1 missing item</span>
        </div>
        <p class={`text-sm ${textColor}`}>Salmon with Roasted Vegetables</p>
        <p class={`text-xs ${textSecondary}`}>35 min · Both goals met</p>
      </div>
      <!-- Wednesday -->
      <div class={`rounded-xl border ${surfaceBorder} p-3`}>
        <div class="flex items-center justify-between mb-1">
          <span class={`text-xs font-semibold ${textColor}`}>Wednesday</span>
          <span class={`text-xs ${primaryColor} bg-opacity-10 px-2 py-0.5 rounded-full`}>All items in pantry</span>
        </div>
        <p class={`text-sm ${textColor}`}>Spinach & Chicken Bowl</p>
        <p class={`text-xs ${textSecondary}`}>20 min · Both goals met</p>
      </div>
      <!-- Thursday -->
      <div class={`rounded-xl border ${surfaceBorder} p-3`}>
        <div class="flex items-center justify-between mb-1">
          <span class={`text-xs font-semibold ${textColor}`}>Thursday</span>
          <span class={`text-xs ${primaryColor} bg-opacity-10 px-2 py-0.5 rounded-full`}>3 missing items</span>
        </div>
        <p class={`text-sm ${textColor}`}>Beef Tacos with Avocado</p>
        <p class={`text-xs ${textSecondary}`}>30 min · Both goals met</p>
      </div>
      <!-- Friday -->
      <div class={`rounded-xl border ${surfaceBorder} p-3`}>
        <div class="flex items-center justify-between mb-1">
          <span class={`text-xs font-semibold ${textColor}`}>Friday</span>
          <span class={`text-xs ${isV2 ? 'text-v2-secondary' : 'text-terracotta-dark'} bg-opacity-10 px-2 py-0.5 rounded-full`}>All items in pantry</span>
        </div>
        <p class={`text-sm ${textColor}`}>Chicken Fried Rice</p>
        <p class={`text-xs ${textSecondary}`}>30 min · Both goals met</p>
      </div>
    </div>
  </div>

  <!-- Grocery List Summary -->
  <div class={`px-4 py-3 border-t ${surfaceBorder}`}>
    <div class="flex items-center justify-between">
      <span class={`text-xs font-semibold ${textColor}`}>Shopping List: 6 items</span>
      <span class={`text-xs ${primaryColor} font-medium`}>View List →</span>
    </div>
  </div>
</div>
