---
interface Props {
  version?: 'v1' | 'v2';
}

const { version = 'v2' } = Astro.props;
const isV2 = version === 'v2';
const primaryColor = isV2 ? 'text-v2-primary' : 'text-sage';
const primaryBg = isV2 ? 'bg-v2-primary' : 'bg-sage';
const surfaceBg = isV2 ? 'bg-v2-surface-container-lowest' : 'bg-white';
const surfaceBorder = isV2 ? 'border-v2-outline-variant' : 'border-border';
const textColor = isV2 ? 'text-v2-on-surface' : 'text-text-primary';
const textSecondary = isV2 ? 'text-v2-on-surface-variant' : 'text-text-secondary';
---

<div class={`${surfaceBg} rounded-2xl border ${surfaceBorder} overflow-hidden shadow-sm`}>
  <!-- App Header -->
  <div class={`px-4 py-3 border-b ${surfaceBorder} flex items-center justify-between`}>
    <div class="flex items-center gap-2">
      <div class={`w-6 h-6 rounded-lg ${primaryBg}`}></div>
      <span class={`text-sm font-semibold ${textColor}`}>Couples Food System</span>
    </div>
    <span class={`text-xs ${textSecondary}`}>Meal Picker</span>
  </div>

  <!-- Mode Toggle -->
  <div class={`px-4 py-3 border-b ${surfaceBorder}`}>
    <div class={`inline-flex items-center ${isV2 ? 'bg-v2-surface-container' : 'bg-cream-dark'} rounded-full p-1 border ${surfaceBorder}`}>
      <button class={`px-4 py-2 rounded-full text-xs font-semibold ${primaryBg} text-white shadow-sm`}>
        Cook Now
      </button>
      <button class={`px-4 py-2 rounded-full text-xs font-semibold ${textSecondary}`}>
        I Want This
      </button>
    </div>
  </div>

  <!-- Cook Now Mode Content -->
  <div class="p-4">
    <p class={`text-xs font-semibold ${textColor} mb-3`}>Meals you can make right now:</p>
    <div class="space-y-2">
      <!-- Meal 1 -->
      <div class={`rounded-xl border-2 ${isV2 ? 'border-v2-primary' : 'border-sage'} p-3`}>
        <div class="flex items-center justify-between mb-2">
          <div>
            <p class={`text-sm font-semibold ${textColor}`}>Chicken Stir-Fry</p>
            <p class={`text-xs ${textSecondary}`}>25 min · 450-700 cal</p>
          </div>
          <span class={`text-xs font-bold ${primaryColor} bg-opacity-10 px-2 py-1 rounded-full`}>100% Match</span>
        </div>
        <div class="flex flex-wrap gap-1">
          <span class={`text-xs px-2 py-0.5 rounded-full bg-green-100 text-green-700`}>✓ Chicken</span>
          <span class={`text-xs px-2 py-0.5 rounded-full bg-green-100 text-green-700`}>✓ Rice</span>
          <span class={`text-xs px-2 py-0.5 rounded-full bg-green-100 text-green-700`}>✓ Spinach</span>
        </div>
        <div class={`mt-2 flex items-center justify-center`}>
          <span class={`text-xs ${primaryColor} font-medium`}>Tap to start cooking →</span>
        </div>
      </div>
      <!-- Meal 2 -->
      <div class={`rounded-xl border ${surfaceBorder} p-3`}>
        <div class="flex items-center justify-between mb-2">
          <div>
            <p class={`text-sm font-semibold ${textColor}`}>Spinach & Chicken Bowl</p>
            <p class={`text-xs ${textSecondary}`}>20 min · 400-650 cal</p>
          </div>
          <span class={`text-xs font-bold ${primaryColor} bg-opacity-10 px-2 py-1 rounded-full`}>100% Match</span>
        </div>
        <div class="flex flex-wrap gap-1">
          <span class={`text-xs px-2 py-0.5 rounded-full bg-green-100 text-green-700`}>✓ Chicken</span>
          <span class={`text-xs px-2 py-0.5 rounded-full bg-green-100 text-green-700`}>✓ Spinach</span>
          <span class={`text-xs px-2 py-0.5 rounded-full bg-green-100 text-green-700`}>✓ Garlic</span>
        </div>
      </div>
      <!-- Meal 3 -->
      <div class={`rounded-xl border ${surfaceBorder} p-3`}>
        <div class="flex items-center justify-between mb-2">
          <div>
            <p class={`text-sm font-semibold ${textColor}`}>Chicken Fried Rice</p>
            <p class={`text-xs ${textSecondary}`}>30 min · 500-750 cal</p>
          </div>
          <span class={`text-xs font-bold ${primaryColor} bg-opacity-10 px-2 py-1 rounded-full`}>100% Match</span>
        </div>
        <div class="flex flex-wrap gap-1">
          <span class={`text-xs px-2 py-0.5 rounded-full bg-green-100 text-green-700`}>✓ Chicken</span>
          <span class={`text-xs px-2 py-0.5 rounded-full bg-green-100 text-green-700`}>✓ Rice</span>
          <span class={`text-xs px-2 py-0.5 rounded-full bg-green-100 text-green-700`}>✓ Onion</span>
        </div>
      </div>
    </div>
  </div>

  <!-- Bottom Note -->
  <div class={`px-4 py-3 border-t ${surfaceBorder} flex items-center justify-center`}>
    <span class={`text-xs ${textSecondary}`}>All meals use ingredients you already have</span>
  </div>
</div>
